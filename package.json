{
  "name": "mock-ai-provider",
  "version": "0.1.1",
  "description": "Provider-compatible mock servers for OpenAI, Anthropic, and other AI APIs.",
  "keywords": [
    "openai",
    "openai-compatible",
    "mock-openai",
    "mock-ai",
    "mock-provider",
    "ai-provider",
    "ai-provider-mock",
    "provider-mock",
    "anthropic-mock",
    "google-ai-mock",
    "openrouter-mock",
    "llm",
    "testing",
    "ci",
    "local-development",
    "responses-api",
    "chat-completions",
    "embeddings",
    "anthropic",
    "google-ai",
    "openrouter"
  ],
  "license": "MIT",
  "author": "Shakker",
  "packageManager": "pnpm@10.29.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shakkernerd/mock-ai-provider.git"
  },
  "bugs": {
    "url": "https://github.com/shakkernerd/mock-ai-provider/issues"
  },
  "homepage": "https://github.com/shakkernerd/mock-ai-provider#readme",
  "type": "module",
  "bin": {
    "mock-ai-provider": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "media",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "serve": "pnpm run build && node dist/cli.js serve --providers openai",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test",
    "package:check": "node scripts/package-check.mjs --skip-version-check",
    "version:update": "node scripts/update-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
